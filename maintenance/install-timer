#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")"
units=${XDG_CONFIG_HOME:-"$HOME/.config"}/systemd/user
install -Dm755 refresh "$HOME/.local/bin/project-registry-refresh"
install -Dm644 project-registry.service "$units/project-registry.service"
install -Dm644 project-registry.timer "$units/project-registry.timer"
systemctl --user daemon-reload
systemctl --user enable --now project-registry.timer
systemctl --user list-timers project-registry.timer
